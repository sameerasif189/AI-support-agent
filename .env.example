# Copy to .env and fill in values.

# Neon Postgres (use the pooled connection string for serverless / Vercel)
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Groq (OpenAI-compatible API, free tier)
LLM_API_BASE=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_api_key
LLM_MODEL=llama-3.1-8b-instant

# Local GPU — native llama.cpp GGUF in-process (no Ollama)
LOCAL_LLM_BACKEND=native
# https://huggingface.co/bartowski/Qwen2.5-7B-Instruct-GGUF/tree/main
HF_GGUF_REPO=bartowski/Qwen2.5-7B-Instruct-GGUF
HF_GGUF_FILENAME=Qwen2.5-7B-Instruct-Q4_K_M.gguf
LOCAL_GGUF_PATH=models/Qwen2.5-7B-Instruct-Q4_K_M.gguf
LOCAL_LLM_N_GPU_LAYERS=-1
LOCAL_LLM_PRELOAD=false
LOCAL_LLM_TIMEOUT_SEC=180
LLM_ORDER=local,api

# Optional local dev
# RAG learning + live API feeds
RAG_FEED_SYNC_ENABLED=true
RAG_FEED_SYNC_TICK_SEC=60
RAG_FEED_AUTO_BOOTSTRAP=true
RAG_FEED_DEFAULT_URL=http://127.0.0.1:8000/
RAG_FEED_CURATE_WITH_API=true
LEARN_FROM_CHAT=true
LEARN_MIN_CONFIDENCE=0.72
LEARN_CUSTOMER_MEMORY=true
CHAT_MEMORY_IN_PROMPT=true
CHAT_HISTORY_TURNS=6
# Rewrite chat Q&A into KB articles using Groq (LLM_API_*), not the local model
LEARN_EXPAND_WITH_API=true
KNOWLEDGE_WEBHOOK_KEY=

# Full vector RAG on Neon (pgvector) — embeddings are separate from Groq chat
RAG_VECTOR_ENABLED=true
RAG_RETRIEVAL_MODE=hybrid
RAG_CHUNK_SIZE_TOKENS=400
RAG_CHUNK_OVERLAP_TOKENS=60
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_API_KEY=your_openai_api_key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

APP_PORT=8000

# Meta WhatsApp Cloud API (Vercel demo — see docs/vercel_whatsapp_demo.md)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=erp-ai-verify
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DEMO_ERP_UID=1

# Vercel: use cloud LLM only; disable background feed sync
# LLM_ORDER=api
# RAG_FEED_SYNC_ENABLED=false

# Infigo / marketing-site embed (https://infigosolutions.com/) — see docs/infigo_website_integration.md
SITE_BOT_ENABLED=true
PUBLIC_CHAT_API_KEY=change-me-to-a-long-random-secret
SITE_COMPANY_NAME=Infigo Solutions
SITE_CONTACT_EMAIL=
SITE_BOOKING_URL=
SITE_PROPOSAL_URL=https://infigosolutions.com/
CORS_ALLOWED_ORIGINS=https://infigosolutions.com,https://www.infigosolutions.com
SITE_RAG_FEED_URL=https://infigosolutions.com/
